# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# prisma
/src/generated
/prisma/*.db
/prisma/*.db-journal

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
test-results/

# Schermate di verifica prodotte da `npm run shots`: sono un artefatto di
# controllo, rigenerabile in un comando, e ogni giro ne scrive ~24 a 2x. Le
# schermate scelte per raccontare il progetto stanno nella `screenshots/` della
# radice, e quelle sì sono versionate.
/screenshots/

# Tracce, snapshot e report degli E2E falliti: artefatti di diagnosi, pesanti
# (una traccia è uno zip con l'intera timeline) e rigenerabili rieseguendo la
# suite.
/test-results/
/playwright-report/
