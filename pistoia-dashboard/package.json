{
  "name": "pistoia-dashboard",
  "version": "0.52.0",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "astryx": "node node_modules/@astryxdesign/cli/bin/astryx.mjs",
    "theme:build": "node node_modules/@astryxdesign/cli/bin/astryx.mjs theme build ./src/themes/pistoia.ts --out ./src/themes/generated/pistoia.css",
    "theme:watch": "node node_modules/@astryxdesign/cli/bin/astryx.mjs theme build ./src/themes/pistoia.ts --out ./src/themes/generated/pistoia.css --watch",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "prisma migrate reset --force && tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "setup": "prisma migrate dev --name init && tsx prisma/seed.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "pretest:e2e": "node scripts/misura.mjs --solo-pulizia",
    "test:e2e": "playwright test",
    "a11y": "playwright test accessibilita",
    "bersagli": "playwright test bersagli",
    "contenimento": "playwright test contenimento",
    "lighthouse": "node scripts/misura.mjs -- npx --yes @lhci/cli@0.15.1 autorun",
    "shots": "node scripts/shots.mjs",
    "impronta": "node scripts/misura.mjs --server -- node scripts/impronta.mjs",
    "impronta:confronta": "node scripts/misura.mjs --server -- node scripts/impronta.mjs --confronta",
    "rotte": "node scripts/rotte.mjs",
    "produzione": "node scripts/produzione.mjs",
    "atti": "tsx scripts/atti.ts",
    "atti:freschezza": "tsx scripts/atti-freschezza.ts",
    "typecheck": "tsc --noEmit"
  },
  "browserslist": [
    "chrome >= 123",
    "edge >= 123",
    "firefox >= 120",
    "safari >= 17.5",
    "ios_saf >= 17.5"
  ],
  "dependencies": {
    "@astryxdesign/cli": "^0.1.8",
    "@astryxdesign/core": "^0.1.8",
    "@astryxdesign/theme-neutral": "^0.1.8",
    "@node-rs/argon2": "^2.0.2",
    "@prisma/adapter-better-sqlite3": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@stylexjs/stylex": "^0.19.0",
    "better-sqlite3": "^12.10.0",
    "clsx": "^2.1.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.17.0",
    "motion": "^12.40.0",
    "next": "16.3.0",
    "next-themes": "^0.4.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tailwind-merge": "^3.6.0",
    "uqr": "^0.1.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.60.0",
    "@tailwindcss/postcss": "^4",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "prisma": "^7.9.1",
    "tailwindcss": "^4",
    "tsx": "^4.22.4",
    "typescript": "^5",
    "vitest": "^4.1.8"
  }
}
